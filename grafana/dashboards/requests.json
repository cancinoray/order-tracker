{
  "title": "Order Tracker - Requests and Errors",
  "uid": "order-tracker-requests",
  "tags": ["order-tracker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request count by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_status_code) (http_server_request_count_total)",
          "legendFormat": "{{http_route}} {{http_status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate (5m) by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_status_code) (rate(http_server_request_count_total[5m]))",
          "legendFormat": "{{http_route}} {{http_status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors (4xx/5xx) by route and status",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route, http_status_code) (http_server_request_count_total{http_status_code=~\"4..|5..\"})",
          "legendFormat": "{{http_route}} {{http_status_code}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum by (http_route, status_code) (http_server_request_count_total{status_code=~\"4..|5..\"})",
          "legendFormat": "{{http_route}} {{status_code}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request duration (p95)",
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_bucket[5m])))",
          "legendFormat": "{{http_route}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
